**/venv/

# Editors, logs, and operating-system files.
**/.vscode/
**/.idea/
*.log
.DS_Store

# Local secrets. Committed examples remain allowed.
**/.env
**/.env.*
!**/.env.example
**/*token.json*
**/*credentials.json*
**/*.pem
**/*.key
